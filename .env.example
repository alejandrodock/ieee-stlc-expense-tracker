# Supabase (obligatorio)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
# Solo servidor — nunca exponer en el navegador
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Copia opcional de cada PDF en Google Drive.
# Opción A (recomendada, Drive personal): Web App de Apps Script — ver scripts/drive-upload.gs
GOOGLE_DRIVE_SCRIPT_URL=
GOOGLE_DRIVE_SCRIPT_SECRET=

# Opción B: cuenta de servicio (solo funciona con una Unidad compartida de Workspace).
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_DRIVE_CLIENT_EMAIL=
GOOGLE_DRIVE_PRIVATE_KEY=
